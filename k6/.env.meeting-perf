# Fixed fixture generated by sql/reset_and_seed.sql
BASE_URL=http://127.0.0.1:8080
TEAM_ROOM_ID=1
TARGET_YEAR=2026
TARGET_MONTH=3

# Preferred path: let load-test.js mint a short-lived access token from the same
# JWT secret that the app is using. Set this to the target environment's
# JWT_SECRET value before running k6.
JWT_SECRET_BASE64=
JWT_ISSUER=yamoyo-application
JWT_ACCESS_EXPIRATION_SECONDS=3600
FIXTURE_USER_ID=1
FIXTURE_EMAIL=perf-user-00001@yamoyo.test
FIXTURE_PROVIDER=test
FIXTURE_ONBOARDING_STATUS=COMPLETED

# Optional override: if this is set, load-test.js uses it instead of generating
# a token from JWT_SECRET_BASE64 and fixture claims.
ACCESS_TOKEN=

# Only used for meeting_list_same_load_compare.
COMPARE_RATE=180

# Local verification convenience values.
SMOKE_VUS=1
SMOKE_ITERATIONS=5
SMOKE_MAX_DURATION=30s
